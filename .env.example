# Discord credentials — https://discord.com/developers/applications
#
# The portal shows four credentials and only these two are used here:
#
#   Bot Token       Bot tab (left sidebar) -> "Reset Token". Shown ONCE.
#                   Three dot-separated parts:
#                     <base64 bot id>.<timestamp>.<signature>
#   Application ID  General Information. A 17-20 digit number.
#
#   Public Key      NOT USED. 64 hex characters, for HTTP interaction
#                   endpoints — this bot connects over the gateway instead.
#   Client Secret   NOT USED. OAuth2 only.
#
# Paste the token WITHOUT a "Bot " prefix. Startup will tell you if you have
# picked up the wrong credential.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Storage
DATABASE_PATH=./data/pickems.db

# Scheduling
DEFAULT_TIMEZONE=America/Chicago

# Optional: restrict slash-command registration to one guild for fast dev iteration
DEV_GUILD_ID=

LOG_LEVEL=info
